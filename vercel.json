    },
    {
      "source": "/pages/consultoria-estrategica.html",
      "destination": "/consultoria-estrategica",
      "permanent": true
    },
    {
      "source": "/pages/iso-42001.html",
      "destination": "/iso-42001",
      "permanent": true
    },
    {
      "source": "/pages/autodiagnostico-iso-42001.html",
      "destination": "/autodiagnostico-iso-42001",
      "permanent": true
    },
    {
      "source": "/pages/partners.html",
      "destination": "/partners",
      "permanent": true
    },
    {
      "source": "/pages/politica-cookies.html",
      "destination": "/politica-cookies",
      "permanent": true
    },
    {
      "source": "/pages/politica-privacidad.html",
      "destination": "/politica-privacidad",
      "permanent": true
    },
    {
      "source": "/politica-priv",
      "destination": "/politica-privacidad",
      "permanent": true
    },
    {
      "source": "/pages/educacion.html",
      "destination": "/educacion",
      "permanent": true
    },
    {
      "source": "/pages/hospitality.html",
      "destination": "/hospitality",
      "permanent": true
    },
    {
      "source": "/pages/residencia-fiscal.html",
      "destination": "/residencia-fiscal",
      "permanent": true
    },
    {
      "source": "/pages/trazabilidad-agroalimentaria.html",
      "destination": "/trazabilidad-agroalimentaria",
      "permanent": true
    },
    {
      "source": "/pages/sistema-advantys.html",
      "destination": "/sistema-advantys",
      "permanent": true
    },
    {
      "source": "/pages/soluciones-ia.html",
      "destination": "/soluciones-ia",
      "permanent": true
    },
    {
      "source": "/pages/solicitud.html",
      "destination": "/solicitud",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
