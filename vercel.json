    },
    {
      "source": "/consultoria-estrategica",
      "destination": "/pages/consultoria-estrategica.html"
    },
    {
      "source": "/educacion",
      "destination": "/pages/soluciones/educacion.html"
    },
    {
      "source": "/hospitality",
      "destination": "/pages/soluciones/hospitality.html"
    },
    {
      "source": "/residencia-fiscal",
      "destination": "/pages/soluciones/residencia-fiscal.html"
    },
